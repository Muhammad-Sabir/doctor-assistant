{
  "cli": {
    "version": ">= 13.1.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://glowworm-casual-wolf.ngrok-free.app",
        "EXPO_PUBLIC_WS_URL": "wss://glowworm-casual-wolf.ngrok-free.app"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://glowworm-casual-wolf.ngrok-free.app",
        "EXPO_PUBLIC_WS_URL": "wss://glowworm-casual-wolf.ngrok-free.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://glowworm-casual-wolf.ngrok-free.app",
        "EXPO_PUBLIC_WS_URL": "wss://glowworm-casual-wolf.ngrok-free.app"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
